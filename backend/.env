# Docker Registry
DOCKER_REGISTRY=

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
# HTTPS Configuration - use HTTPS with SSL certificates
ASPNETCORE_URLS=https://+:8887
# Enable HTTPS in Kestrel
UseHttps=true
# Disable IPv6 for Supabase compatibility
DOTNET_SYSTEM_NET_DISABLEIPV6=true

# Port Configuration
API_PORT=8887
POSTGRES_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_USER=abdulqader
POSTGRES_PASSWORD=BaObk42oig2y
POSTGRES_DB=MahamDB
POSTGRES_HOST_AUTH_METHOD=md5

# PostgreSQL Performance Settings
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB

# Supabase Configuration
SUPABASE_HOST=db.ctlaeyiulnukpoxuztla.supabase.co
SUPABASE_IP=34.82.126.136

# Container Names
API_CONTAINER_NAME=zradminwebapi
POSTGRES_CONTAINER_NAME=postgres

# Network Configuration
NETWORK_NAME=maham_network

# Health Check Configuration
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5