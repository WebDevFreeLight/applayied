# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# SECURITY: This is a TEMPLATE file. Copy to .env and fill in your values.
# NEVER commit the actual .env file to source control!
#
# Add .env to your .gitignore file:
#   echo ".env" >> .gitignore
# =============================================================================

# Docker Registry (leave empty for local builds)
DOCKER_REGISTRY=

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:8887
UseHttps=true
DOTNET_SYSTEM_NET_DISABLEIPV6=true

# Port Configuration
API_PORT=8887

# =============================================================================
# DATABASE CONFIGURATION
# SECURITY: Generate strong passwords using:
#   openssl rand -base64 32
# =============================================================================
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_DB=your_database_name
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# PostgreSQL Performance Settings
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# Container Names
API_CONTAINER_NAME=zradminwebapi
POSTGRES_CONTAINER_NAME=postgres

# Network Configuration
NETWORK_NAME=maham_network

# Health Check Configuration
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5

# =============================================================================
# SECRETS THAT SHOULD BE IN GITHUB SECRETS (not here)
# =============================================================================
# These are listed here for documentation only.
# In CI/CD, these should come from GitHub Secrets:
#
# - SSH_PRIVATE_KEY: SSH private key for deployment
# - SERVER_HOST: Production server IP
# - DEPLOY_USER: Non-root deployment user
# - DEPLOY_PATH: Deployment directory path
# - DOCKER_USERNAME: Docker registry username (if using)
# - DOCKER_PASSWORD: Docker registry password (if using)
