@model ZR.Model.EventManagement.Dto.EventZoneMapViewModel
<!DOCTYPE html>
<html dir='rtl' lang='ar'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Zone Map - @Model.EventData.Eventname</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .container {
            background: white;
            padding: 30px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .header h1 {
            color: #007bff;
            margin: 0;
            font-size: 32px;
        }
        .zones-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        .zone-card {
            border: 2px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }
        .zone-header {
            background-color: #007bff;
            color: white;
            padding: 15px;
            text-align: center;
        }
        .zone-header h3 {
            margin: 0;
            font-size: 18px;
        }
        .zone-code {
            font-size: 12px;
            opacity: 0.9;
        }
        .zone-details {
            padding: 15px;
        }
        .zone-details p {
            margin: 5px 0;
            font-size: 14px;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #eee;
        }
    </style>
</head>
<body>
    <div class='container'>
        <div class='header'>
            <h1>خريطة المناطق / Zone Map</h1>
            <h2 style='color: #666;'>@Model.EventData.Eventnamear / @Model.EventData.Eventname</h2>
        </div>
        <div class='zones-grid'>
            @foreach (var zone in Model.Zones)
            {
                <div class='zone-card'>
                    <div class='zone-header' style='background-color: @(zone.ColorCode ?? "#007bff");'>
                        <h3>@zone.ZoneNameAr / @zone.ZoneName</h3>
                        <span class='zone-code'>@zone.ZoneCode</span>
                    </div>
                    <div class='zone-details'>
                        <p><strong>Type:</strong> @zone.ZoneType</p>
                        <p><strong>Capacity:</strong> @zone.MaxCapacity?.ToString("N0")</p>
                        <p><strong>Area:</strong> @zone.AreaSqm?.ToString("N2") m²</p>
                        <p><strong>Floor:</strong> @zone.FloorNumber</p>
                        <p><strong>Access:</strong> @zone.AccessLevel</p>
                        <p><strong>Status:</strong> @zone.Status</p>
                    </div>
                </div>
            }
        </div>
        <div class='footer'>
            <p>Generated on: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        </div>
    </div>
</body>
</html>
