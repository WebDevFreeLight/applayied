@model ZR.Admin.WebApi.Controllers.Finance.ARAP.APInvoiceExportViewModel
@using ZR.Model.Finance.ARAP.Enums
<!DOCTYPE html>
<html dir='rtl' lang='ar'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Vendor Invoice - فاتورة مورد - @Model.InvoiceNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #7c3aed;
            --primary-light: #a78bfa;
            --secondary-color: #0f172a;
            --accent-color: #059669;
            --success-color: #059669;
            --warning-color: #d97706;
            --danger-color: #dc2626;
            --border-color: #e5e7eb;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --bg-light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', 'Cairo', 'Arial', sans-serif;
            margin: 0;
            padding: 15px;
            background-color: #f8f9fa;
            color: var(--text-dark);
            line-height: 1.5;
            font-size: 12px;
        }

        .invoice-container {
            background: white;
            max-width: 210mm;
            margin: 0 auto;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
        }

        /* Header */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 3px solid var(--primary-color);
        }

        .company-branding {
            flex: 1;
        }

        .company-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 3px;
        }

        .company-name-ar {
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            font-family: 'Cairo', sans-serif;
            margin-bottom: 8px;
        }

        .company-info {
            font-size: 11px;
            color: var(--text-light);
            line-height: 1.6;
        }

        .vat-badge {
            display: inline-block;
            background: var(--bg-light);
            padding: 4px 10px;
            border-radius: 4px;
            font-family: monospace;
            font-weight: 600;
            font-size: 11px;
            margin-top: 5px;
            border: 1px solid var(--border-color);
        }

        .invoice-meta {
            text-align: left;
            min-width: 220px;
        }

        .invoice-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 3px;
        }

        .invoice-title-ar {
            font-size: 18px;
            font-weight: 600;
            color: var(--secondary-color);
            font-family: 'Cairo', sans-serif;
            margin-bottom: 10px;
        }

        .invoice-number {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary-color);
            font-family: monospace;
            margin-bottom: 8px;
            background: var(--bg-light);
            padding: 5px 10px;
            border-radius: 4px;
            display: inline-block;
        }

        .invoice-dates {
            font-size: 11px;
            color: var(--text-dark);
        }

        .date-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
            padding: 2px 0;
        }

        .date-label {
            color: var(--text-light);
        }

        .date-value {
            font-weight: 500;
            font-family: monospace;
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            margin-top: 8px;
        }

        .status-draft { background: #e5e7eb; color: #374151; }
        .status-posted { background: #dbeafe; color: #1d4ed8; }
        .status-partiallypaid { background: #fef3c7; color: #d97706; }
        .status-paid { background: #d1fae5; color: #059669; }
        .status-overdue { background: #fee2e2; color: #dc2626; }
        .status-cancelled { background: #f3f4f6; color: #6b7280; }

        /* Invoice Type Badge */
        .invoice-type-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            background: #f3e8ff;
            color: #7c3aed;
            margin-bottom: 8px;
        }

        /* Parties Section */
        .parties-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .party-card {
            padding: 15px;
            background: var(--bg-light);
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .party-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--primary-color);
        }

        .party-info {
            font-size: 11px;
        }

        .party-row {
            display: flex;
            margin-bottom: 5px;
        }

        .party-label {
            font-weight: 600;
            min-width: 90px;
            color: var(--text-light);
        }

        .party-value {
            color: var(--text-dark);
            flex: 1;
        }

        /* Items Table */
        .items-section {
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--border-color);
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .items-table thead {
            background: var(--primary-color);
            color: white;
        }

        .items-table th {
            padding: 10px 8px;
            text-align: right;
            font-weight: 600;
            border: none;
        }

        .items-table th:first-child {
            border-radius: 4px 0 0 0;
        }

        .items-table th:last-child {
            border-radius: 0 4px 0 0;
        }

        .items-table tbody tr {
            border-bottom: 1px solid var(--border-color);
        }

        .items-table tbody tr:nth-child(even) {
            background: var(--bg-light);
        }

        .items-table td {
            padding: 10px 8px;
            text-align: right;
            vertical-align: top;
        }

        .numeric-cell {
            font-family: 'Courier New', monospace;
            font-weight: 500;
            text-align: left;
        }

        /* Summary Section */
        .summary-section {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-bottom: 20px;
        }

        .notes-card {
            background: var(--bg-light);
            padding: 15px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .notes-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .notes-content {
            font-size: 11px;
            color: var(--text-dark);
            line-height: 1.6;
        }

        .totals-card {
            background: white;
            padding: 15px;
            border-radius: 6px;
            border: 2px solid var(--border-color);
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 12px;
        }

        .total-label {
            font-weight: 500;
            color: var(--text-dark);
        }

        .total-value {
            font-weight: 600;
            font-family: 'Courier New', monospace;
            color: var(--text-dark);
        }

        .total-row.grand-total {
            border-top: 2px solid var(--primary-color);
            border-bottom: none;
            margin-top: 8px;
            padding-top: 12px;
            font-size: 14px;
        }

        .total-row.grand-total .total-value {
            color: var(--primary-color);
            font-size: 16px;
        }

        /* Footer */
        .invoice-footer {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 2px solid var(--border-color);
            font-size: 10px;
            color: var(--text-light);
            text-align: center;
        }

        .legal-disclaimer {
            margin: 10px 0;
            padding: 10px;
            background: #faf5ff;
            border-radius: 4px;
            border-right: 3px solid var(--primary-color);
            text-align: right;
            direction: rtl;
            font-size: 10px;
        }

        .generated-info {
            font-family: monospace;
            margin-top: 8px;
            color: var(--text-light);
            font-size: 9px;
        }

        /* Bilingual helpers */
        .bilingual {
            display: flex;
            justify-content: space-between;
        }

        .ar {
            direction: rtl;
            text-align: right;
            font-family: 'Cairo', 'Arial', sans-serif;
        }

        .en {
            direction: ltr;
            text-align: left;
        }

        /* Print Styles */
        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice-container {
                box-shadow: none;
                border: none;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class='invoice-container'>
        <!-- Invoice Header -->
        <div class='invoice-header'>
            <div class='company-branding'>
                <div class='company-name'>MAHAM Technologies</div>
                <div class='company-name-ar'>شركة ماحام للتقنية</div>
                <div class='company-info'>
                    <div>Riyadh, Kingdom of Saudi Arabia</div>
                    <div>الرياض، المملكة العربية السعودية</div>
                    <div>Phone: +966 11 123 4567 | Email: info@maham.sa</div>
                    <div class='vat-badge'>VAT No. الرقم الضريبي: 300123456789123</div>
                </div>
            </div>

            <div class='invoice-meta'>
                <div class='invoice-type-badge'>AP - Accounts Payable</div>
                <div class='invoice-title'>VENDOR INVOICE</div>
                <div class='invoice-title-ar'>فاتورة مورد</div>
                <div class='invoice-number'>@Model.InvoiceNumber</div>
                <div class='invoice-dates'>
                    <div class='date-row'>
                        <span class='date-label'>Invoice Date تاريخ الفاتورة:</span>
                        <span class='date-value'>@Model.InvoiceDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class='date-row'>
                        <span class='date-label'>Due Date تاريخ الاستحقاق:</span>
                        <span class='date-value'>@Model.DueDate.ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
                <div class="status-badge status-@Model.StatusName.ToLower().Replace(" ", "")">
                    @Model.StatusName - @Model.StatusNameAr
                </div>
            </div>
        </div>

        <!-- Parties Section -->
        <div class='parties-section'>
            <div class='party-card'>
                <div class='party-title'>المورد / Vendor</div>
                <div class='party-info'>
                    <div class='party-row'>
                        <span class='party-label'>Code الرمز:</span>
                        <span class='party-value'>@Model.VendorCode</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>Name الاسم:</span>
                        <span class='party-value'>@(Model.VendorName ?? "-") @(!string.IsNullOrEmpty(Model.VendorNameAr) ? $"/ {Model.VendorNameAr}" : "")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.VendorTaxNumber))
                    {
                        <div class='party-row'>
                            <span class='party-label'>VAT الضريبي:</span>
                            <span class='party-value'>@Model.VendorTaxNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VendorAddress))
                    {
                        <div class='party-row'>
                            <span class='party-label'>Address العنوان:</span>
                            <span class='party-value'>@Model.VendorAddress</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VendorEmail))
                    {
                        <div class='party-row'>
                            <span class='party-label'>Email البريد:</span>
                            <span class='party-value'>@Model.VendorEmail</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.VendorPhone))
                    {
                        <div class='party-row'>
                            <span class='party-label'>Phone الهاتف:</span>
                            <span class='party-value'>@Model.VendorPhone</span>
                        </div>
                    }
                </div>
            </div>

            <div class='party-card'>
                <div class='party-title'>المشتري / Buyer (Us)</div>
                <div class='party-info'>
                    <div class='party-row'>
                        <span class='party-label'>Name الاسم:</span>
                        <span class='party-value'>MAHAM Technologies / شركة ماحام للتقنية</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>VAT الضريبي:</span>
                        <span class='party-value'>300123456789123</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>Address العنوان:</span>
                        <span class='party-value'>Riyadh, KSA / الرياض</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Items -->
        <div class='items-section'>
            <div class='section-title'>تفاصيل الفاتورة / Invoice Details</div>
            <table class='items-table'>
                <thead>
                    <tr>
                        <th style="width: 30px;">#</th>
                        <th>الوصف / Description</th>
                        <th style="width: 80px;">الكمية / Qty</th>
                        <th style="width: 100px;">السعر / Price</th>
                        <th style="width: 100px;">المبلغ / Amount</th>
                        <th style="width: 60px;">الضريبة %</th>
                        <th style="width: 80px;">الضريبة / Tax</th>
                        <th style="width: 100px;">الإجمالي / Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines != null && Model.Lines.Any())
                    {
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class='numeric-cell'>@line.LineNumber</td>
                                <td>@(line.Description ?? "-")</td>
                                <td class='numeric-cell'>@line.Quantity.ToString("N2")</td>
                                <td class='numeric-cell'>@line.UnitPrice.ToString("N2")</td>
                                <td class='numeric-cell'>@line.Amount.ToString("N2")</td>
                                <td class='numeric-cell'>@line.TaxRate.ToString("N0")%</td>
                                <td class='numeric-cell'>@line.TaxAmount.ToString("N2")</td>
                                <td class='numeric-cell'>@line.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 20px; color: var(--text-light);">
                                No line items - لا توجد بنود
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary Section -->
        <div class='summary-section'>
            <div class='notes-card'>
                <div class='notes-title'>ملاحظات / Notes</div>
                <div class='notes-content'>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div style="margin-bottom: 8px;"><strong>Description:</strong> @Model.Description</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                    {
                        <div style="margin-bottom: 8px;"><strong>Reference:</strong> @Model.ReferenceNumber</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div>@Model.Notes</div>
                    }
                    @if (string.IsNullOrEmpty(Model.Description) && string.IsNullOrEmpty(Model.Notes))
                    {
                        <div style="color: var(--text-light);">No notes - لا توجد ملاحظات</div>
                    }
                </div>
            </div>

            <div class='totals-card'>
                <div class='total-row'>
                    <span class='total-label'>المجموع الفرعي / Subtotal:</span>
                    <span class='total-value'>@Model.Subtotal.ToString("N2") @Model.Currency</span>
                </div>

                <div class='total-row'>
                    <span class='total-label'>ضريبة القيمة المضافة / VAT:</span>
                    <span class='total-value'>@Model.TaxAmount.ToString("N2") @Model.Currency</span>
                </div>

                <div class='total-row grand-total'>
                    <span class='total-label'>المجموع الإجمالي / Total:</span>
                    <span class='total-value'>@Model.TotalAmount.ToString("N2") @Model.Currency</span>
                </div>

                @if (Model.PaidAmount > 0)
                {
                    <div class='total-row' style="border-top: 1px dashed var(--border-color); margin-top: 8px; padding-top: 8px;">
                        <span class='total-label'>المدفوع / Paid:</span>
                        <span class='total-value' style="color: var(--success-color);">@Model.PaidAmount.ToString("N2") @Model.Currency</span>
                    </div>
                    <div class='total-row'>
                        <span class='total-label'>المتبقي / Balance:</span>
                        <span class='total-value' style="color: var(--danger-color);">@Model.RemainingAmount.ToString("N2") @Model.Currency</span>
                    </div>
                }
            </div>
        </div>

        <!-- Footer -->
        <div class='invoice-footer'>
            <div class='legal-disclaimer'>
                هذه فاتورة مورد (حسابات دائنة) مسجلة في نظام ERP.
                يرجى التحقق من جميع البيانات قبل إجراء أي عملية دفع.
                <br/>
                This is a vendor invoice (Accounts Payable) recorded in the ERP system.
                Please verify all details before processing any payment.
            </div>

            <div class='generated-info'>
                Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") UTC | Document: AP Invoice | System: MAHAM ERP
            </div>
        </div>
    </div>
</body>
</html>
