@model ZR.Admin.WebApi.Controllers.Finance.ARAP.ARInvoiceExportViewModel
@using ZR.Model.Finance.ARAP.Enums
<!DOCTYPE html>
<html dir='rtl' lang='ar'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>فاتورة ضريبية - @Model.InvoiceNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1e40af;
            --primary-light: #3b82f6;
            --secondary-color: #0f172a;
            --accent-color: #059669;
            --success-color: #059669;
            --warning-color: #d97706;
            --danger-color: #dc2626;
            --border-color: #e5e7eb;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --bg-light: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', 'Arial', sans-serif;
            margin: 0;
            padding: 15px;
            background-color: #f8f9fa;
            color: var(--text-dark);
            line-height: 1.7;
            font-size: 12px;
            direction: rtl;
        }

        .invoice-container {
            background: white;
            max-width: 210mm;
            margin: 0 auto;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
        }

        /* Header */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 3px solid var(--primary-color);
        }

        .company-branding {
            flex: 1;
        }

        .company-name {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .company-info {
            font-size: 11px;
            color: var(--text-light);
            line-height: 1.8;
        }

        .vat-badge {
            display: inline-block;
        
            padding: 2px 10px;
            border-radius: 4px;
            font-family: monospace;
            font-weight: 600;
            font-size: 11px;
            margin-top: 2px;
      
        }

        .invoice-meta {
            text-align: left;
            min-width: 220px;
        }

        .invoice-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 2px;
        }

        .invoice-number {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary-color);
            font-family: monospace;
            margin-bottom: 3px;
           
            padding: 2px 10px;
            border-radius: 4px;
            display: inline-block;
        }

        .invoice-dates {
            font-size: 11px;
            color: var(--text-dark);
        }

        .date-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
            padding: 2px 0;
        }

        .date-label {
            color: var(--text-light);
        }

        .date-value {
            font-weight: 500;
            font-family: monospace;
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            margin-top: 8px;
        }

        .status-draft { background: #e5e7eb; color: #374151; }
        .status-posted { background: #dbeafe; color: #1d4ed8; }
        .status-partiallypaid { background: #fef3c7; color: #d97706; }
        .status-paid { background: #d1fae5; color: #059669; }
        .status-overdue { background: #fee2e2; color: #dc2626; }
        .status-cancelled { background: #f3f4f6; color: #6b7280; }

        /* Parties Section */
        .parties-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .party-card {
            padding: 15px;
            background: var(--bg-light);
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .party-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--primary-color);
        }

        .party-info {
            font-size: 11px;
        }

        .party-row {
            display: flex;
            margin-bottom: 5px;
        }

        .party-label {
            font-weight: 600;
            min-width: 80px;
            color: var(--text-light);
        }

        .party-value {
            color: var(--text-dark);
            flex: 1;
        }

        /* Items Table */
        .items-section {
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--border-color);
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .items-table thead {
            background: var(--primary-color);
            color: white;
        }

        .items-table th {
            padding: 10px 8px;
            text-align: right;
            font-weight: 600;
            border: none;
        }

        .items-table th:first-child {
            border-radius: 0 4px 0 0;
        }

        .items-table th:last-child {
            border-radius: 4px 0 0 0;
        }

        .items-table tbody tr {
            border-bottom: 1px solid var(--border-color);
        }

        .items-table tbody tr:nth-child(even) {
            background: var(--bg-light);
        }

        .items-table td {
            padding: 10px 8px;
            text-align: right;
            vertical-align: top;
        }

        .numeric-cell {
            font-family: 'Courier New', monospace;
            font-weight: 500;
            text-align: left;
        }

        /* Summary Section */
        .summary-section {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-bottom: 20px;
        }

        .notes-card {
            background: var(--bg-light);
            padding: 15px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .notes-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .notes-content {
            font-size: 11px;
            color: var(--text-dark);
            line-height: 1.8;
        }

        .totals-card {
            background: white;
            padding: 15px;
            border-radius: 6px;
            border: 2px solid var(--border-color);
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 12px;
        }

        .total-label {
            font-weight: 500;
            color: var(--text-dark);
        }

        .total-value {
            font-weight: 600;
            font-family: 'Courier New', monospace;
            color: var(--text-dark);
        }

        .total-row.grand-total {
            border-top: 2px solid var(--primary-color);
            border-bottom: none;
            margin-top: 8px;
            padding-top: 12px;
            font-size: 14px;
        }

        .total-row.grand-total .total-value {
            color: var(--primary-color);
            font-size: 16px;
        }

        /* ZATCA Section */
        .zatca-section {
            margin-bottom: 20px;
            padding: 15px;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border-radius: 6px;
            border: 1px solid #bae6fd;
        }

        .zatca-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .zatca-grid {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 15px;
            align-items: start;
        }

        .zatca-info {
            font-size: 10px;
        }

        .zatca-row {
            margin-bottom: 4px;
            display: flex;
        }

        .zatca-label {
            font-weight: 600;
            min-width: 120px;
            color: var(--text-dark);
        }

        .zatca-value {
            font-family: monospace;
            color: var(--text-dark);
            word-break: break-all;
            font-size: 9px;
        }

        .qr-placeholder {
            width: 100px;
            height: 100px;
            background: white;
            border: 2px dashed var(--border-color);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            font-size: 10px;
            color: var(--text-light);
            text-align: center;
        }

        /* Footer - Modern Design with Page Break Prevention */
        .invoice-footer {
            margin-top: 25px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            padding: 20px;
            background: linear-gradient(135deg, var(--bg-light) 0%, #f1f5f9 100%);
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .footer-section {
            text-align: center;
        }

        .footer-section-title {
            font-size: 9px;
            font-weight: 600;
            color: var(--primary-color);
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .footer-section-content {
            font-size: 10px;
            color: var(--text-dark);
            line-height: 1.7;
        }

        .footer-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border-color), transparent);
            margin: 15px 0;
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
            background: var(--primary-color);
            border-radius: 0 0 8px 8px;
            margin-top: -8px;
        }

        .footer-brand {
            font-size: 10px;
            font-weight: 600;
            color: white;
            letter-spacing: 0.5px;
        }

        .footer-timestamp {
            font-size: 9px;
            color: rgba(255, 255, 255, 0.8);
            font-family: monospace;
        }

        .footer-compliance {
            text-align: center;
            padding: 10px 20px;
            font-size: 9px;
            color: var(--text-light);
            background: white;
            border-radius: 8px 8px 0 0;
        }

        /* Print Styles */
        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice-container {
                box-shadow: none;
                border: none;
                padding: 15px;
            }

            .invoice-footer {
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .zatca-section {
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .summary-section {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class='invoice-container'>
        <!-- Invoice Header -->
        <div class='invoice-header'>
            <div class='company-branding'>
                <div class='company-name'>شركة مهام لتقنية المعلومات</div>
                <div class='company-info'>
                    <div>الرياض، المملكة العربية السعودية</div>
                    <div>هاتف: 4567 123 11 966+ | بريد: info@maham.sa</div>
                    <div class='vat-badge'>الرقم الضريبي: 300123456789123</div>
                </div>
            </div>

            <div class='invoice-meta'>
                <div class='invoice-title'>فاتورة ضريبية</div>
                <div class='invoice-number'>@Model.InvoiceNumber</div>
                <div class='invoice-dates'>
                    <div class='date-row'>
                        <span class='date-label'>تاريخ الإصدار:</span>
                        <span class='date-value'>@Model.InvoiceDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class='date-row'>
                        <span class='date-label'>تاريخ الاستحقاق:</span>
                        <span class='date-value'>@Model.DueDate.ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
             
            </div>
        </div>

        <!-- Parties Section -->
        <div class='parties-section'>
            <div class='party-card'>
                <div class='party-title'>البائع</div>
                <div class='party-info'>
                    <div class='party-row'>
                        <span class='party-label'>الاسم:</span>
                        <span class='party-value'>شركة مهام لتقنية المعلومات</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>الرقم الضريبي:</span>
                        <span class='party-value'>300123456789123</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>العنوان:</span>
                        <span class='party-value'>الرياض، المملكة العربية السعودية</span>
                    </div>
                </div>
            </div>

            <div class='party-card'>
                <div class='party-title'>المشتري</div>
                <div class='party-info'>
                    <div class='party-row'>
                        <span class='party-label'>الرمز:</span>
                        <span class='party-value'>@Model.CustomerCode</span>
                    </div>
                    <div class='party-row'>
                        <span class='party-label'>الاسم:</span>
                        <span class='party-value'>@(Model.CustomerNameAr ?? Model.CustomerName ?? "-")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CustomerTaxNumber))
                    {
                        <div class='party-row'>
                            <span class='party-label'>الرقم الضريبي:</span>
                            <span class='party-value'>@Model.CustomerTaxNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CustomerAddressAr) || !string.IsNullOrEmpty(Model.CustomerAddress))
                    {
                        <div class='party-row'>
                            <span class='party-label'>العنوان:</span>
                            <span class='party-value'>@(Model.CustomerAddressAr ?? Model.CustomerAddress)</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                    {
                        <div class='party-row'>
                            <span class='party-label'>البريد:</span>
                            <span class='party-value'>@Model.CustomerEmail</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <div class='party-row'>
                            <span class='party-label'>الهاتف:</span>
                            <span class='party-value'>@Model.CustomerPhone</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Invoice Items -->
        <div class='items-section'>
            <div class='section-title'>تفاصيل الفاتورة</div>
            <table class='items-table'>
                <thead>
                    <tr>
                        <th style="width: 30px;">#</th>
                        <th>الوصف</th>
                        <th style="width: 80px;" class="numeric-cell">الكمية</th>
                        <th style="width: 100px;" class="numeric-cell">سعر الوحدة</th>
                        <th style="width: 100px;" class="numeric-cell">المبلغ</th>
                        <th style="width: 60px;" class="numeric-cell">الضريبة %</th>
                        <th style="width: 80px;" class="numeric-cell">الضريبة</th>
                        <th style="width: 100px;" class="numeric-cell">الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines != null && Model.Lines.Any())
                    {
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@(line.Description ?? "-")</td>
                                <td class='numeric-cell'>@line.Quantity.ToString("N2")</td>
                                <td class='numeric-cell'>@line.UnitPrice.ToString("N2")</td>
                                <td class='numeric-cell'>@line.Amount.ToString("N2")</td>
                                <td class='numeric-cell'>@line.TaxRate.ToString("N0")%</td>
                                <td class='numeric-cell'>@line.TaxAmount.ToString("N2")</td>
                                <td class='numeric-cell'>@line.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 20px; color: var(--text-light);">
                                لا توجد بنود
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary Section -->
        <div class='summary-section'>
            <div class='notes-card'>
                <div class='notes-title'>ملاحظات</div>
                <div class='notes-content'>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div style="margin-bottom: 8px;"><strong>الوصف:</strong> @Model.Description</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                    {
                        <div style="margin-bottom: 8px;"><strong>المرجع:</strong> @Model.ReferenceNumber</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div>@Model.Notes</div>
                    }
                    @if (string.IsNullOrEmpty(Model.Description) && string.IsNullOrEmpty(Model.Notes))
                    {
                        <div style="color: var(--text-light);">لا توجد ملاحظات</div>
                    }
                </div>
            </div>

            <div class='totals-card'>
                <div class='total-row'>
                    <span class='total-label'>المجموع الفرعي:</span>
                    <span class='total-value'>@Model.Subtotal.ToString("N2") @Model.Currency</span>
                </div>

                <div class='total-row'>
                    <span class='total-label'>ضريبة القيمة المضافة:</span>
                    <span class='total-value'>@Model.TaxAmount.ToString("N2") @Model.Currency</span>
                </div>

                <div class='total-row grand-total'>
                    <span class='total-label'>المجموع الإجمالي:</span>
                    <span class='total-value'>@Model.TotalAmount.ToString("N2") @Model.Currency</span>
                </div>

                @if (Model.PaidAmount > 0)
                {
                    <div class='total-row' style="border-top: 1px dashed var(--border-color); margin-top: 8px; padding-top: 8px;">
                        <span class='total-label'>المدفوع:</span>
                        <span class='total-value' style="color: var(--success-color);">@Model.PaidAmount.ToString("N2") @Model.Currency</span>
                    </div>
                    <div class='total-row'>
                        <span class='total-label'>المتبقي:</span>
                        <span class='total-value' style="color: var(--danger-color);">@Model.RemainingAmount.ToString("N2") @Model.Currency</span>
                    </div>
                }
            </div>
        </div>

        <!-- ZATCA Compliance Section -->
        <div class='zatca-section'>
            <div class='zatca-title'>
                <span>&#9432;</span>
                معلومات التوافق الضريبي (هيئة الزكاة والضريبة والجمارك)
            </div>
            <div class='zatca-grid'>
                <div class='zatca-info'>
                    <div class='zatca-row'>
                        <span class='zatca-label'>معرف الفاتورة:</span>
                        <span class='zatca-value'>@Model.InvoiceUUID</span>
                    </div>
                    <div class='zatca-row'>
                        <span class='zatca-label'>تجزئة الفاتورة:</span>
                        <span class='zatca-value'>@Model.InvoiceHash</span>
                    </div>
                    <div class='zatca-row'>
                        <span class='zatca-label'>تاريخ ووقت الإصدار:</span>
                        <span class='zatca-value'>@Model.InvoiceDate.ToString("yyyy-MM-ddTHH:mm:ss")</span>
                    </div>
                </div>

                <div class='qr-placeholder'>
                    <div style="font-size: 24px;">&#9634;</div>
                    <div>رمز QR</div>
                    <div style="font-size: 8px;">متوافق مع ZATCA</div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class='invoice-footer'>
            <div class='footer-compliance'>
                هذه الفاتورة صادرة وفقاً لمتطلبات هيئة الزكاة والضريبة والجمارك. يرجى الاحتفاظ بها لمدة 5 سنوات لأغراض التدقيق.
            </div>
            <div class='footer-content'>
                <div class='footer-section'>
                    <div class='footer-section-title'>تواصل معنا</div>
                    <div class='footer-section-content'>
                        هاتف: 4567 123 11 966+<br/>
                        بريد: info@maham.sa
                    </div>
                </div>
                <div class='footer-section'>
                    <div class='footer-section-title'>العنوان</div>
                    <div class='footer-section-content'>
                        الرياض<br/>
                        المملكة العربية السعودية
                    </div>
                </div>
                <div class='footer-section'>
                    <div class='footer-section-title'>المعلومات الضريبية</div>
                    <div class='footer-section-content'>
                        الرقم الضريبي: 300123456789123<br/>
                        السجل التجاري: 1010XXXXXX
                    </div>
                </div>
            </div>
            <div class='footer-bottom'>
                <div class='footer-brand'>نظام مهام للموارد</div>
                <div class='footer-timestamp'>تم الإنشاء: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            </div>
        </div>
    </div>
</body>
</html>
