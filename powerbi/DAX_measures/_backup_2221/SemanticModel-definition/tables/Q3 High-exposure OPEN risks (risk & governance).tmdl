	partition 'Q3 High-exposure OPEN risks (risk & governance)' = m
		mode: directQuery
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("localhost", "MahamDB"), "-- Q3 — High-exposure OPEN risks (risk & governance)#(lf)-- Exposure score = probability * impact; ""high"" = score >= 12. Closed/Mitigated risks are#(lf)-- excluded so a closed high risk never counts as open (edge case in the data).#(lf)SELECT  r.risk_id,#(lf)        r.title                                   AS risk_title,#(lf)        r.kind,                                   -- Risk | Issue#(lf)        p.code                                    AS project_code,#(lf)        p.name                                    AS project_name,#(lf)        p.dept_id,#(lf)        COALESCE(u.nickname, u.username)          AS owner,#(lf)        r.probability,#(lf)        r.impact,#(lf)        r.score                                   AS exposure_score,#(lf)        r.status#(lf)FROM    pmo_risk r#(lf)JOIN    pmo_project p ON p.project_id = r.project_id#(lf)LEFT JOIN sys_user u  ON u.userid     = r.owner_user_id#(lf)WHERE   r.status = 'Open'#(lf)  AND   r.score >= 12#(lf)ORDER BY r.score DESC, p.name#(lf)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

