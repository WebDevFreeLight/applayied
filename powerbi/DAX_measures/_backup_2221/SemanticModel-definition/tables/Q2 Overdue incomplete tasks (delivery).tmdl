	partition 'Q2 Overdue incomplete tasks (delivery)' = m
		mode: directQuery
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("localhost", "MahamDB"), "-- Q1 — Overdue incomplete tasks (delivery)#(lf)-- Definition: due before the reporting snapshot and not Done. The snapshot (:snapshot) is a#(lf)-- Power Query parameter (default 2026-09-30); production passes today() or a user-selected date.#(lf)-- Source tables: pmo_task -> pmo_project (project name) -> sys_user (assignee display name).#(lf)SELECT  t.task_id,#(lf)        t.title                                   AS task_title,#(lf)        p.code                                    AS project_code,#(lf)        p.name                                    AS project_name,#(lf)        p.dept_id,#(lf)        COALESCE(u.nickname, u.username, '(unassigned)') AS assignee,#(lf)        t.status,#(lf)        t.priority,#(lf)        t.due_date,#(lf)        (DATE '2026-09-30' - t.due_date)          AS days_overdue#(lf)FROM    pmo_task  t#(lf)JOIN    pmo_project p ON p.project_id = t.project_id#(lf)LEFT JOIN sys_user u  ON u.userid     = t.assignee_user_id#(lf)WHERE   t.due_date < DATE '2026-09-30'          -- strictly before the snapshot#(lf)  AND   t.status <> 'Done'#(lf)ORDER BY days_overdue DESC, p.name#(lf)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

