/// Disconnected date parameter. Use as a single-select slicer; [Snapshot Date] defaults to 2026-09-30 when nothing is selected.
table Snapshot
	lineageTag: 5ccec389-9d26-488d-a491-1808855084a1

	column Snapshot
		formatString: yyyy-mm-dd
		lineageTag: 78348cbb-0be3-4e66-aedd-b02380c20ff5
		isNameInferred
		sourceColumn: [Snapshot]

	partition Snapshot = calculated
		mode: import
		source = SELECTCOLUMNS ( CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2027, 12, 31 ) ), "Snapshot", [Date] )

