		summarizeBy: none
		sourceColumn: roadmap_bucket

		annotation SummarizationSetBy = Automatic

	partition 'Q5Milestone status & roadmap (delivery)' = m
		mode: directQuery
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("localhost", "MahamDB"), "-- Q5 — Milestone status & roadmap (delivery)#(lf)-- Status relative to the snapshot: Achieved, or Overdue (pending & past due), or Upcoming.#(lf)SELECT  m.milestone_id,#(lf)        m.name              AS milestone_name,#(lf)        p.code              AS project_code,#(lf)        p.name              AS project_name,#(lf)        p.dept_id,#(lf)        m.due_date,#(lf)        m.status,#(lf)        CASE#(lf)            WHEN m.status = 'Achieved'                               THEN 'Achieved'#(lf)            WHEN m.due_date < DATE '2026-09-30' AND m.status <> 'Achieved' THEN 'Overdue'#(lf)            ELSE 'Upcoming'#(lf)        END                 AS roadmap_bucket#(lf)FROM    pmo_milestone m#(lf)JOIN    pmo_project p ON p.project_id = m.project_id#(lf)ORDER BY m.due_date#(lf)", null, [EnableFolding=true])
				in
				    Source

	changedProperty = Name

	annotation PBI_ResultType = Table

