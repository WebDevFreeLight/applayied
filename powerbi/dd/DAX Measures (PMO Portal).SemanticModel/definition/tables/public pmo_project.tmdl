	/// Project status in Arabic.
	column status_ar = SWITCH ( 'public pmo_project'[status], "Active", "نشط", "OnHold", "معلّق", "Planning", "تخطيط", "Completed", "مكتمل", 'public pmo_project'[status] )
		dataType: string
		lineageTag: ee13c091-c91c-4c9a-9952-c4f7acd35715
		summarizeBy: none

	partition 'public pmo_project' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "MahamDB"),
				    public_pmo_project = Source{[Schema="public",Item="pmo_project"]}[Data]
				in
				    public_pmo_project

	annotation PBI_ResultType = Table

