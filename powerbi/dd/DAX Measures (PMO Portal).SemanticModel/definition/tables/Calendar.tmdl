table Calendar
	lineageTag: c762431a-01d0-49b4-b6b7-ec266e6e68f4
	dataCategory: Time

	column Date
		isUnique
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 119e09f9-8328-4b36-8040-817a026c6e27
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 0c445f0c-a5b6-474d-8b95-1be1202176ca
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: 11bf0faa-dd01-4822-bc80-47102edb8dd8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	column MonthName
		lineageTag: a54b59a0-f833-4ca7-98dc-98b9fb22b964
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthName]
		sortByColumn: Month

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: 8fd30a39-6eeb-442e-b0af-5d5778e99e24
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	/// Gregorian month name in Arabic, sorted by Month (YYYY-MM).
	column MonthNameAr = SWITCH ( MONTH ( 'Calendar'[Date] ), 1, "يناير", 2, "فبراير", 3, "مارس", 4, "أبريل", 5, "مايو", 6, "يونيو", 7, "يوليو", 8, "أغسطس", 9, "سبتمبر", 10, "أكتوبر", 11, "نوفمبر", 12, "ديسمبر" ) & " " & YEAR ( 'Calendar'[Date] )
		dataType: string
		lineageTag: 4b9d6645-0418-42e3-bea8-778e86024fd3
		summarizeBy: none
		sortByColumn: Month

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE (2025,1,1), DATE (2027,12,31) ),
				    "Year", YEAR ([Date]), "Month", FORMAT ([Date],"YYYY-MM"),
				    "MonthName", FORMAT ([Date],"MMM yyyy"), "Quarter", "Q" & FORMAT ([Date],"Q")
				)

	annotation PBI_Id = 8ca180964e594622a6c22edc4c29057d

