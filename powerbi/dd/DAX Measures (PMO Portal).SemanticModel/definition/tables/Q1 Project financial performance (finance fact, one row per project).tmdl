/// Applies the documented definitions exactly:
/// --   current approved budget = initial + SUM(approved revisions)   (pending/rejected excluded)
/// --   actual spend            = SUM(posted cost txns on/before the snapshot)  (drafts excluded)
/// --   remaining               = approved - actual
/// --   utilization %           = actual / approved          (NULL when approved = 0)
/// --   EAC                     = actual + forecast-to-complete
/// --   projected variance      = approved - EAC
/// -- Aggregates are pre-grouped per table to AVOID fan-out inflation from joining
/// -- budget + cost + forecast in one flat join.
table 'Q1 Project financial performance (finance fact, one row per project)'
	lineageTag: 94f509c3-ada6-4ef6-a76b-09e79e45cb73

	column project_id
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 367a40bc-e8e5-49d7-b67a-186d42bf7801
		summarizeBy: sum
		sourceColumn: project_id

		annotation SummarizationSetBy = Automatic

	column project_code
		dataType: string
		sourceProviderType: nvarchar(-1)
		lineageTag: d48b6ad9-c0db-4d92-8bc3-414547daf67c
		summarizeBy: none
		sourceColumn: project_code

		annotation SummarizationSetBy = Automatic

	column project_name
		dataType: string
		sourceProviderType: nvarchar(-1)
		lineageTag: 717f1122-0c37-4d3b-bff0-9c2e33174d1f
		summarizeBy: none
		sourceColumn: project_name

		annotation SummarizationSetBy = Automatic

	column dept_id
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: f19d9f92-5414-4f71-8860-7b8c1db5f195
		summarizeBy: sum
		sourceColumn: dept_id

		annotation SummarizationSetBy = Automatic

	column status
		dataType: string
		sourceProviderType: nvarchar(-1)
		lineageTag: 8a3c1b9c-2fec-4588-be3b-49933c7da9b2
		summarizeBy: none
		sourceColumn: status

		annotation SummarizationSetBy = Automatic

	column approved_budget
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: decc22e1-f3f4-44ea-8bd8-94f8c34d0a8e
		summarizeBy: sum
		sourceColumn: approved_budget

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column actual_spend
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: 98158e3f-836b-4bb2-abc9-a6b12f1d6598
		summarizeBy: sum
		sourceColumn: actual_spend

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column remaining_budget
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: b7a160e9-5f8a-48fe-93af-c2bbda10fc59
		summarizeBy: sum
		sourceColumn: remaining_budget

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column utilization_pct
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: 91eabda0-5ce7-48fd-a308-e09c3de94c31
		summarizeBy: sum
		sourceColumn: utilization_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column eac
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: dd7284cc-60ea-466f-8eff-f55feefd1989
		summarizeBy: sum
		sourceColumn: eac

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column projected_variance
		dataType: double
		sourceProviderType: decimal(0, 0)
		lineageTag: e318c942-910f-4451-89cf-47f30da31967
		summarizeBy: sum
		sourceColumn: projected_variance

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Q1 Project financial performance (finance fact, one row per project)' = m
		mode: directQuery
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("localhost", "MahamDB"), "-- Q2 — Project financial performance (finance fact, one row per project)#(lf)-- Applies the documented definitions exactly:#(lf)--   current approved budget = initial + SUM(approved revisions)   (pending/rejected excluded)#(lf)--   actual spend            = SUM(posted cost txns on/before the snapshot)  (drafts excluded)#(lf)--   remaining               = approved - actual#(lf)--   utilization %           = actual / approved          (NULL when approved = 0)#(lf)--   EAC                     = actual + forecast-to-complete#(lf)--   projected variance      = approved - EAC#(lf)-- Aggregates are pre-grouped per table to AVOID fan-out inflation from joining#(lf)-- budget + cost + forecast in one flat join.#(lf)WITH budget AS (#(lf)    SELECT p.project_id, p.name, p.code, p.dept_id, p.owner_user_id, p.status,#(lf)           p.initial_approved_budget#(lf)         + COALESCE(SUM(r.amount) FILTER (WHERE r.status = 'Approved'), 0) AS approved_budget#(lf)    FROM   pmo_project p#(lf)    LEFT   JOIN pmo_budget_revision r ON r.project_id = p.project_id#(lf)    GROUP  BY p.project_id, p.name, p.code, p.dept_id, p.owner_user_id, p.status, p.initial_approved_budget#(lf)),#(lf)spend AS (#(lf)    SELECT project_id,#(lf)           SUM(amount) FILTER (WHERE status = 'Posted' AND txn_date <= DATE '2026-09-30') AS actual_spend#(lf)    FROM   pmo_cost_transaction#(lf)    GROUP  BY project_id#(lf)),#(lf)ftc AS (#(lf)    SELECT project_id, SUM(forecast_amount) FILTER (WHERE kind = 'ForecastToComplete') AS forecast_to_complete#(lf)    FROM   pmo_financial_forecast#(lf)    GROUP  BY project_id#(lf))#(lf)SELECT  b.project_id, b.code AS project_code, b.name AS project_name, b.dept_id, b.status,#(lf)        b.approved_budget,#(lf)        COALESCE(s.actual_spend, 0)                                   AS actual_spend,#(lf)        b.approved_budget - COALESCE(s.actual_spend, 0)               AS remaining_budget,#(lf)        ROUND(COALESCE(s.actual_spend,0) / NULLIF(b.approved_budget,0) * 100, 1) AS utilization_pct,#(lf)        COALESCE(s.actual_spend,0) + COALESCE(f.forecast_to_complete,0)          AS eac,#(lf)        b.approved_budget - (COALESCE(s.actual_spend,0) + COALESCE(f.forecast_to_complete,0)) AS projected_variance#(lf)FROM    budget b#(lf)LEFT    JOIN spend s ON s.project_id = b.project_id#(lf)LEFT    JOIN ftc   f ON f.project_id = b.project_id#(lf)ORDER BY b.name#(lf)", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_ResultType = Table

