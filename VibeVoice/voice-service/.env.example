# ---- Engine routing --------------------------------------------------------
# vibevoice | edge | dev   (falls back automatically if vibevoice is not installed)
TTS_ENGINE=vibevoice
# Arabic text goes here (VibeVoice-Realtime ships no Arabic voice preset)
ARABIC_TTS_ENGINE=edge
# Used when TTS_ENGINE cannot be loaded; 'dev' is the last resort
FALLBACK_TTS_ENGINE=edge
# none | whisper | vibevoice  (vibevoice = 7B model, big GPU only; falls back to whisper)
ASR_ENGINE=whisper

# ---- VibeVoice realtime TTS ------------------------------------------------
# HF id (auto-download) or a local folder, e.g. models/VibeVoice-Realtime-0.5B
VIBEVOICE_MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
# Folder with the official *.pt presets (copied by scripts/setup_vibevoice)
VIBEVOICE_VOICES_DIR=voices/streaming_model
VIBEVOICE_DEFAULT_VOICE=en-Carter_man
# auto | cuda | mps | cpu
VIBEVOICE_DEVICE=auto
VIBEVOICE_CFG_SCALE=1.5
VIBEVOICE_DDPM_STEPS=5

# ---- VibeVoice ASR (ASR_ENGINE=vibevoice) ----------------------------------
VIBEVOICE_ASR_MODEL_PATH=microsoft/VibeVoice-ASR
VIBEVOICE_ASR_LANGUAGE_MODEL=Qwen/Qwen2.5-7B
VIBEVOICE_ASR_MAX_NEW_TOKENS=4096

# ---- edge-tts (needs internet) ----------------------------------------------
EDGE_VOICE_EN=en-US-AriaNeural
EDGE_VOICE_AR=ar-SA-HamedNeural
EDGE_TIMEOUT_SECONDS=60

# ---- faster-whisper ---------------------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# auto | cpu | cuda   (auto probes CUDA and falls back to CPU if cuBLAS/cuDNN are missing)
WHISPER_DEVICE=auto
# auto -> int8 on cpu, float16 on cuda
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true

# ---- Limits / misc ------------------------------------------------------------
MAX_TTS_CHARS=5000
MAX_CHUNK_CHARS=400
CHUNK_SILENCE_MS=150
MAX_UPLOAD_MB=50
PRELOAD_MODELS=false
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
CORS_ORIGINS=*
FFMPEG_BINARY=ffmpeg
