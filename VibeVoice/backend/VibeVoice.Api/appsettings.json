{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=storage/vibevoice.db",
    "Seed": false,
    "LogSql": false
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Uploads": {
    "MaxImageBytes": 10485760,
    "MaxAudioBytes": 52428800,
    "MaxFilesPerRequest": 20,
    "MaxRequestBytes": 125829120
  },
  "VoiceService": {
    "BaseUrl": "http://localhost:8001",
    "RequestTimeoutSeconds": 300,
    "HealthTimeoutSeconds": 3
  },
  "Jwt": {
    "Issuer": "VibeVoice",
    "Audience": "VibeVoice",
    "Key": "",
    "ExpiryHours": 168
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
