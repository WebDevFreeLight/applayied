# Copy to .env (never commit .env).

# Required: 32+ random characters used to sign login tokens.
JWT_KEY=replace-with-a-long-random-secret-0123456789abcdef

# Ports on the host
API_PORT=5080
FRONTEND_PORT=8080

# Insert the demo account (admin@vibevoice.local / Admin123!) and sample data on first start.
SEED_DEMO=true

# ---- Database (default: SQLite file in the storage volume) ----
DB_PROVIDER=Sqlite
DB_CONNECTION=Data Source=storage/vibevoice.db
# PostgreSQL (run with: docker compose --profile postgres up):
# DB_PROVIDER=PostgreSQL
# DB_CONNECTION=Host=postgres;Port=5432;Database=vibevoice;Username=vibevoice;Password=vibevoice
# POSTGRES_PASSWORD=vibevoice

# ---- Voice service ----
# vibevoice needs the upstream package + model (INSTALL_VIBEVOICE=true or the GPU override);
# without it the service falls back to edge-tts automatically.
INSTALL_VIBEVOICE=false
TTS_ENGINE=vibevoice
ARABIC_TTS_ENGINE=edge
ASR_ENGINE=whisper
WHISPER_MODEL=small
VIBEVOICE_MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
