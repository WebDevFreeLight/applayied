# Base path for API calls. Default uses the Vite dev proxy (/api -> backend).
# For a deployed build, set this to the backend origin, e.g. https://pmo.example.com
VITE_API_BASE=/api

# Dev-only: the backend origin the Vite proxy forwards /api to.
# (matches the backend's launchSettings http port; change if you run the API elsewhere)
VITE_API_TARGET=http://localhost:63873
